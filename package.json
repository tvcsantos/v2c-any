{
  "name": "v2c-any",
  "version": "0.9.4",
  "type": "module",
  "description": "Turn any device into V2C Dynamic Power Control",
  "main": "dist/index.js",
  "bin": {
    "v2ca": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "v2c",
    "adapter",
    "dynamic",
    "power",
    "energy",
    "wallbox",
    "meter"
  ],
  "author": "tvcsantos",
  "license": "MIT",
  "homepage": "https://github.com/tvcsantos/v2c-any#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tvcsantos/v2c-any.git"
  },
  "bugs": {
    "url": "https://github.com/tvcsantos/v2c-any/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "node scripts/generate-version.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"README.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"README.md\" \"docs/**/*.md\"",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview"
  },
  "dependencies": {
    "cosmiconfig": "^9.0.2",
    "fastify": "^5.10.0",
    "glob": "^13.0.6",
    "mqtt": "^5.15.2",
    "opossum": "^10.0.0",
    "p-retry": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "undici": "^8.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/opossum": "^8.1.9",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
